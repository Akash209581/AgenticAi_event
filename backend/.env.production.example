# Agentic AI Day 2026 Production Environment Configuration

# Server Settings
NODE_ENV=production
PORT=6007
BASE_API=/cseAI

# Database Connection (Replace with production MongoDB URI or local MongoDB daemon)
MONGODB_URI=mongodb://127.0.0.1:27017/agentic_ai_day

# Security & Admin Access
ADMIN_USERNAME=cseadmin,superadmin
ADMIN_PASSWORD=SetAStrongRandomPasswordHere2026!

# CORS Origins (Comma separated domain names for university site or '*' for open access)
CORS_ORIGIN=http://your-domain.com,https://your-domain.com,http://localhost:3000
